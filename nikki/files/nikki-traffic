#!/bin/sh
# /etc/init.d/nikki-traffic

START=95
STOP=10
USE_PROCD=1
INITFILE=/etc/config/nikki

validate_section() {
    uci_validate_section nikki traffic \
        'enabled:bool:0' \
        'collect_interval:uinteger:30' \
        'db_path:string:/tmp/nikki/traffic.db' \
        'retain_days:uinteger:30'
}

start_service() {
    local enabled interval
    
    config_load nikki
    config_get enabled traffic enabled 0
    config_get interval traffic collect_interval 30
    
    [ "$enabled" != "1" ] && {
        echo "Nikki traffic统计未启用"
        return 0
    }
    
    procd_open_instance
    procd_set_param command /bin/sh
    procd_set_param args "-c 'while true; do /etc/nikki/scripts/traffic-collect.sh collect; sleep $interval; done'"
    procd_set_param respawn
    procd_set_param respawn_threshold 300
    procd_set_param respawn_timeout 5
    procd_set_param stdout 1
    procd_set_param stderr 1
    procd_close_instance
}

stop_service() {
    # 关机前导出数据
    /etc/nikki/scripts/traffic-collect.sh export
}

reload_service() {
    stop
    sleep 1
    start
}

service_triggers() {
    procd_add_reload_trigger "nikki"
}

${RC_SUBREE:+${RC_SUBREE}}