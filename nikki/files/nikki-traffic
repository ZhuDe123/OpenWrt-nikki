#!/bin/sh
# /etc/init.d/nikki-traffic - 流量统计采集服务

START=99
STOP=10

ENGINE="/usr/bin/ucode /etc/nikki/ucode/traffic.uc"
PERSIST_DB="/etc/nikki/traffic.db.bak"
DB_PATH="/tmp/nikki/traffic.db"
PID_FILE="/var/run/nikki-traffic.pid"
LOG_FILE="/tmp/nikki/traffic.log"

start() {
    # 检查是否已启用
    ENABLED=$(uci -q get nikki.traffic.enabled)
    [ "$ENABLED" != "1" ] && {
        echo "Nikki traffic statistics disabled"
        return 1
    }
    
    # 检查是否已在运行
    if [ -f "$PID_FILE" ]; then
        OLD_PID=$(cat "$PID_FILE")
        if kill -0 "$OLD_PID" 2>/dev/null; then
            echo "Service already running (PID: $OLD_PID)"
            return 0
        fi
    fi
    
    # 获取采集间隔
    INTERVAL=$(uci -q get nikki.traffic.collect_interval)
    INTERVAL=${INTERVAL:-30}
    
    # 确保目录存在
    mkdir -p /tmp/nikki
    chmod 0700 /tmp/nikki
    mkdir -p /etc/nikki
    chmod 0755 /etc/nikki
    
    # 启动前尝试从 Flash 恢复数据
    if [ -f "$PERSIST_DB" ] && [ ! -f "$DB_PATH" ]; then
        echo "Restoring traffic database from backup..."
        cp "$PERSIST_DB" "$DB_PATH"
        chmod 0600 "$DB_PATH"
    fi
    
    # 启动后台采集进程（使用 stdin 重定向避免退出）
    ( while true; do $ENGINE collect 2>&1; sleep $INTERVAL; done ) </dev/null > "$LOG_FILE" 2>&1 &
    
    # 保存 PID
    echo $! > "$PID_FILE"
    
    echo "Traffic collection started (interval: ${INTERVAL}s, PID: $(cat $PID_FILE))"
}

stop() {
    if [ -f "$PID_FILE" ]; then
        PID=$(cat "$PID_FILE")
        if kill -0 "$PID" 2>/dev/null; then
            echo "Stopping traffic collection (PID: $PID)..."
            kill "$PID"
            rm -f "$PID_FILE"
            
            # 执行最终备份
            echo "Backing up traffic database..."
            $ENGINE persist 2>&1
        else
            echo "Process not running"
            rm -f "$PID_FILE"
        fi
    else
        echo "Service not running"
    fi
}

restart() {
    stop
    sleep 1
    start
}

status() {
    ENABLED=$(uci -q get nikki.traffic.enabled)
    
    if [ "$ENABLED" = "1" ]; then
        if [ -f "$PID_FILE" ] && kill -0 $(cat "$PID_FILE") 2>/dev/null; then
            echo "Traffic statistics is ENABLED and RUNNING (PID: $(cat $PID_FILE))"
            return 0
        else
            echo "Traffic statistics is ENABLED but NOT RUNNING"
            return 1
        fi
    else
        echo "Traffic statistics is DISABLED"
        return 1
    fi
}

# 主逻辑
case "$1" in
    start)
        start
        ;;
    stop)
        stop
        ;;
    restart)
        restart
        ;;
    status)
        status
        ;;
    *)
        echo "Usage: $0 {start|stop|restart|status}"
        exit 1
        ;;
esac

exit 0
