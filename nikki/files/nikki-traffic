#!/bin/sh /etc/init.d/nikki-traffic
# /etc/init.d/nikki-traffic

START=99
STOP=10
USE_PROCD=1

ENGINE="/usr/bin/nikki-traffic.uc"
PERSIST_DB="/etc/nikki/traffic.db.bak"
DB_PATH="/tmp/nikki/traffic.db"

validate_section() {
    uci_validate_section nikki traffic \
        'enabled:bool:0' \
        'collect_interval:uinteger:30' \
        'db_path:string:/tmp/nikki/traffic.db' \
        'retain_days:uinteger:30'
}

start_service() {
    local enabled interval

    config_load nikki
    config_get enabled traffic enabled 0
    config_get interval traffic collect_interval 30

    [ "$enabled" != "1" ] && {
        echo "Nikki traffic statistics disabled"
        return 0
    }

    # 确保目录存在
    mkdir -p /tmp/nikki
    chmod 0700 /tmp/nikki
    mkdir -p /etc/nikki
    chmod 0755 /etc/nikki

    # 启动前尝试从 Flash 恢复数据
    if [ -f "$PERSIST_DB" ] && [ ! -f "$DB_PATH" ]; then
        echo "Restoring traffic database from backup..."
        cp "$PERSIST_DB" "$DB_PATH"
        chmod 0600 "$DB_PATH"
    fi

    procd_open_instance "collector"
    procd_set_param command /bin/sh -c "while true; do $ENGINE collect; sleep $interval; done"
    procd_set_param respawn
    procd_set_param respawn_threshold 300
    procd_set_param respawn_timeout 5
    procd_set_param stdout 1
    procd_set_param stderr 1
    procd_close_instance
}

stop_service() {
    # 停止服务时执行最终备份
    echo "Backing up traffic database..."
    $ENGINE persist
}

reload_service() {
    stop
    sleep 1
    start
}

service_triggers() {
    procd_add_reload_trigger "nikki"
}
