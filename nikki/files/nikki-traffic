#!/bin/sh /etc/rc.common

START=99
USE_PROCD=1

. /etc/nikki/scripts/include.sh

start_service() {
    local enabled interval
    config_load nikki
    config_get_bool enabled "traffic" "enabled" 0
    config_get interval "traffic" "collect_interval" 30

    # 如果配置为禁用，则停止服务并退出
    if [ "$enabled" != "1" ]; then
        procd_kill_instance nikki-traffic 2>/dev/null
        return 0
    fi

    # 准备目录
    mkdir -p /tmp/nikki /var/run

    # 尝试从闪存恢复备份（路由器重启后自动恢复流量数据）
    if [ -f /etc/nikki/traffic.db.bak ]; then
        ucode "$TRAFFIC_UC" restore
    fi

    # 日志轮转（保留最近 1000 行）
    if [ -f "/tmp/nikki/traffic.log" ]; then
        local log_size=$(wc -l < /tmp/nikki/traffic.log 2>/dev/null || echo "0")
        if [ "$log_size" -gt 1000 ]; then
            tail -n 1000 /tmp/nikki/traffic.log > /tmp/nikki/traffic.log.tmp
            mv /tmp/nikki/traffic.log.tmp /tmp/nikki/traffic.log
        fi
    fi

    # 启动采集进程（使用 procd respawn 管理）
    procd_open_instance nikki-traffic
    procd_set_param command /bin/sh /etc/nikki/scripts/traffic-collect.sh "$interval"
    procd_set_param respawn
    procd_set_param stdout 1
    procd_set_param stderr 1
    procd_set_param pidfile /var/run/nikki-traffic.pid
    procd_close_instance
}

# 停止服务时自动备份（防止数据丢失）
stop_service() {
    # 执行持久化备份
    if [ -f "$TRAFFIC_UC" ]; then
        ucode "$TRAFFIC_UC" persist
    fi
    
    # 等待 1 秒确保备份完成
    sleep 1
}

# 处理配置修改触发的重载
reload_service() {
    # 重新读取配置并重启服务
    stop
    start
}

service_triggers() {
    # 监听 nikki 的 uci 配置变化
    # 当 nikki 配置 reload 时，此服务也会自动 reload
    procd_add_reload_trigger "nikki"
}
